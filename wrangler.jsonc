{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "explore-connecticut-living-staging",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-16",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "observability": {
    "enabled": true
  },
  "unsafe": {
    "bindings": [
      {
        "name": "TOWN_MATCH_RATE_LIMITER",
        "type": "ratelimit",
        "namespace_id": "1001",
        "simple": {
          "limit": 5,
          "period": 60
        }
      }
    ]
  }
}
